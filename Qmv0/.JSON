{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PiNexusQuantumBodyV2",
  "version": "2.0.0",
  "description": "Schema + seeded demo dataset for the Pi-Nexus quantum-resistant multi-chain transaction engine.",
  "supported_chains": [
    "ethereum",
    "solana",
    "pi-network",
    "stellar-soroban"
  ],
  "crypto": {
    "signature_scheme": "lamport-ots-sha256",
    "hash_function": "sha256",
    "commitment_tree": "merkle-binary-sha256",
    "quantum_resistance_basis": "Security reduces to SHA-256 preimage resistance, which is not broken by Shor's algorithm (unlike ECDSA/secp256k1 used natively by Ethereum/Solana/Stellar). Each OTS keypair is single-use; pools are Merkle-aggregated into one reusable quantum address."
  },
  "chain_config": {
    "ethereum": {
      "unit": "wei-gwei-scaled",
      "rpc_method": "eth_sendRawTransaction",
      "explorer": "https://etherscan.io/tx/"
    },
    "solana": {
      "unit": "lamports",
      "rpc_method": "sendTransaction",
      "explorer": "https://explorer.solana.com/tx/"
    },
    "pi-network": {
      "unit": "pi-stroops",
      "rpc_method": "horizon.submit_transaction",
      "explorer": "https://explorepi.app/tx/"
    },
    "stellar-soroban": {
      "unit": "stroops",
      "rpc_method": "soroban.simulate_and_submit",
      "explorer": "https://stellar.expert/explorer/public/tx/"
    }
  },
  "transaction_schema": {
    "type": "object",
    "required": [
      "tx_id",
      "chain",
      "from_quantum_addr",
      "to_address",
      "amount_micro",
      "nonce",
      "timestamp_unix",
      "leaf_index"
    ],
    "properties": {
      "tx_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "chain": {
        "enum": [
          "ethereum",
          "solana",
          "pi-network",
          "stellar-soroban"
        ]
      },
      "from_quantum_addr": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Merkle root commitment of the OTS keypair pool"
      },
      "to_address": {
        "type": "string"
      },
      "amount_micro": {
        "type": "integer",
        "minimum": 0
      },
      "nonce": {
        "type": "integer",
        "minimum": 0
      },
      "timestamp_unix": {
        "type": "integer"
      },
      "leaf_index": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "seeded_demo": {
    "genesis_seed": 2025072607,
    "pool_size_per_identity": 8,
